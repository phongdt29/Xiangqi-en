# Read by `docker compose` itself (for ${VAR} substitution in
# docker-compose.yml) - copy to `.env` in this same root folder.
#
# REVERB_APP_KEY here is only used to bake the *public* key into the
# frontend's build (frontend/Dockerfile build arg). It must be the exact
# same value as REVERB_APP_KEY in backend/.env.production, or the frontend
# won't be able to authenticate to Reverb's channels.

LETSENCRYPT_EMAIL=you@example.com

DB_ROOT_PASSWORD=change-me
DB_DATABASE=xiangqi
DB_USERNAME=xiangqi
DB_PASSWORD=change-me

REVERB_APP_KEY=change-me
