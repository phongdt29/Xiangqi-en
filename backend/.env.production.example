APP_NAME="Xiangqi Online"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.chinesechess.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# `mysql` is the docker-compose service name, resolved over the internal
# compose network - not a public hostname.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xiangqi
DB_USERNAME=xiangqi
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@chinesechess.online"
MAIL_FROM_NAME="${APP_NAME}"

# These 3 must be freshly generated for production - do not reuse dev
# values. `REVERB_APP_KEY` must exactly match the root `.env`'s
# REVERB_APP_KEY (that copy is only what gets baked into the frontend build).
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

# The backend talks to Reverb over the internal docker network directly
# (service name `reverb`, plain http) - this is NOT the public
# wss://ws.chinesechess.online address the browser uses; that one is baked
# into the frontend build separately (see docker-compose.yml `frontend.build.args`).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
