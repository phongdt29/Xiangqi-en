APP_NAME="Xiangqi Online"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.chinesechess.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel hosting: MySQL runs on the same machine as PHP, reached over the
# local socket/loopback as `localhost`. If instead deploying to a VPS via
# docker-compose, this would be the `mysql` service name.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=xiangqi
DB_USERNAME=xiangqi
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# No self-hosted Reverb on shared cPanel hosting - `log` just writes
# broadcast events to the Laravel log instead of failing. The frontend
# polls room state instead of subscribing over a WebSocket. Switch to
# `reverb` only if deployed to a VPS running the reverb service.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@chinesechess.online"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if BROADCAST_CONNECTION=reverb (future VPS path, see
# docker-compose.yml) - unused on shared cPanel hosting.
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
